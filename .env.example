# Base de dados na nuvem (opcional).
#
# Sem estas variáveis a aplicação funciona à mesma, mas só guarda os treinos
# neste dispositivo: não há conta nem sincronização.
#
# Onde encontrar os valores, no painel do Supabase:
#   URL   → Settings → Data API → "Project URL"
#           (ou o botão verde "Connect", no topo, que mostra os dois)
#   Chave → Settings → API Keys → "Publishable key" (sb_publishable_...)
#
# A chave publicável é PÚBLICA por desenho e acaba dentro do JavaScript da
# página. O que protege os dados não é o segredo desta chave, é o Row Level
# Security definido em docs/supabase-setup.sql: cada conta só lê e escreve as
# suas linhas.
#
# NUNCA ponhas aqui uma "Secret key" (sb_secret_...) nem a antiga service_role.
# Essas ignoram o Row Level Security e dariam acesso a tudo a quem abrisse a
# página.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole-aqui-a-chave

# O Supabase chamava a esta chave "anon public". Se for esse o nome que vês no
# painel (separador "Legacy anon, service_role API keys"), serve na mesma —
# podes usar antes esta variável:
# VITE_SUPABASE_ANON_KEY=eyJ...
